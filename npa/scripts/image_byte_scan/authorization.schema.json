{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Image byte scan authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "accepted_verification",
    "archive",
    "verification_report",
    "expected_image_id",
    "helper",
    "config",
    "sources",
    "tools_receipt"
  ],
  "anyOf": [
    {
      "required": [
        "confidentiality"
      ]
    },
    {
      "required": [
        "literal_inventory"
      ]
    }
  ],
  "properties": {
    "schema_version": {
      "const": "npa.image-byte-scan-authorization.v1"
    },
    "accepted_verification": {
      "const": true
    },
    "archive": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "verification_report": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "expected_image_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "helper": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "ready_sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "ready_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "config": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "literal_inventory": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "matching_policy"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "matching_policy": {
          "enum": [
            "exact-substring-v1",
            "exact-or-short-ascii-token-v1"
          ]
        }
      },
      "additionalProperties": false
    },
    "literal_engine": {
      "type": "object",
      "required": [
        "kind",
        "source",
        "wheel",
        "extension"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "aho-corasick-v1"
        },
        "source": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "wheel": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        "extension": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "confidentiality": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "tools_receipt": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  }
}
