# Set NPA_CONFIG_DIR to an owner-only directory when an automation run must
# isolate config.yaml and credentials.yaml from the operator's ~/.npa state.
tokens:
  HF_TOKEN: <your-hugging-face-token>
  # Nebius Token Factory API key (OpenAI-compatible hosted inference).
  # Get one at https://tokenfactory.nebius.com/ -> API keys.
  NEBIUS_TOKEN_FACTORY_KEY: <your-nebius-token-factory-api-key>

ngc:
  api_key: <your-ngc-api-key>
  # org: <your-ngc-org>
  # team: <your-ngc-team>

ssh:
  host: <byovm-host-or-ip>
  user: ubuntu
  key_path: ~/.ssh/id_ed25519

# Storage credentials are authoritative by immutable project ID. `npa configure`
# maintains this versioned map and derives legacy top-level views only for the
# explicitly selected project.
project_credentials:
  schema_version: npa.project-credentials.v2
  current_project_id: <your-exact-project-id>
  projects:
    <your-exact-project-id>:
      aliases: [<your-local-alias>]
      storage:
        aws_access_key_id: <your-s3-access-key-id>
        aws_secret_access_key: <your-s3-secret-access-key>
        endpoint_url: https://storage.eu-north1.nebius.cloud
        bucket: s3://<your-bucket>/<prefix>/
