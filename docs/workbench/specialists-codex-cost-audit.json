  "findings": {
    "auth": "Current same-VM CLI0.153.3 reports ChatGPT login. Historic exact per-request auth/tier receipts were not retained.",
    "old_sessions": "Exact pair3 thread IDs have no rollout files or indexed state/log/history rows on VM or Mac, consistent with --ephemeral. No unrelated session content was read.",
    "tier": "Prior argv ignores user config and contains no service_tier override; inspected system/managed tier files are absent. No provider-returned service tier exists in retained run records; do not assert billed tier.",
    "context": "Astra API long-context pricing applies to each request prompt above272,000 input tokens, not to the sum of a complete agent turn. Aggregate336,912 baseline input cannot prove any particular request crossed threshold; API-equivalent range is conservative and cannot currently be narrowed from saved data.",
    "cache": "Input includes cached and cache-write subsets. Formula ordinary=input\u2212cached\u2212written; price each disjoint subset once. Both pair3 runs report cache writes0.",
    "reasoning": "Output1,566 already includes reasoning72 in baseline; no additional reasoning charge is added.",
    "billing": "ChatGPT quota/credit consumption is separate from API-key billing. Listed credit tariffs do not prove credits were deducted, included quota was exhausted, or marginal cash expense. API-equivalent savings may not save cash inside included quota.",
    "incremental_tofa": "Pair3 hybrid adds a known ToFa token-tariff estimate of$0.19147928, with complete recorded usage and no assumed cache discount. This is an estimate, not an invoice. Actual Codex cash change is unknown.",
    "new_trials": "Private whitelist-only loopback OTEL instrumentation prepared for pairs4/5; request metrics must exactly reconcile to CLI aggregate before narrowing any range.",
    "excluded_scope": "This supervising development/research conversation, preparation/model probes, compute/storage/network, human work and subscription allocation are not included in the six measured-arm token costs. Its actual invoice cost has not been established."
  },
  "formula": {
    "astra_short": "((input\u2212cached\u2212written)*10 + cached*1 + written*12.5 + output*50)/1e6",
    "astra_long": "((input\u2212cached\u2212written)*20 + cached*2 + written*25 + output*75)/1e6",
    "codex_standard_credits": "((input\u2212cached)*250 + cached*25 + output*1250)/1e6",
    "tofa": "(all_recorded_input*published_input_rate + output*published_output_rate)/1e6"
  },
