# Run output and logs
results/
runs/
logs/
*.log
*.log*

# Terraform state, plans, and provider working directories
.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl
!deploy/cluster/.terraform.lock.hcl
*.tfvars
!*.tfvars.example
tfplan
*.tfplan
terraform_backend_local.tf
terraform_backend_override.tf

# Credentials, secrets, and local environment files
credentials.yaml
credentials.yml
.npa/credentials.yaml
.npa/credentials.yml
.npa/config.yaml
.npa/agents/
**/auth.env
**/credentials/
**/credentials.yaml
**/credentials.yml
.env
.env.*
**/.env
**/.env.*
!.env.example
*.pem
*.key
**/*.pem
**/*.key
*.kubeconfig
**/*.kubeconfig
id_rsa
id_ed25519
secrets.yaml
secrets.yml
**/secrets/
**/secrets.yaml
**/secrets.yml

# Python caches, environments, and build artifacts
__pycache__/
*.py[cod]
*$py.class
.eggs/
*.egg-info/
dist/
build/
.venv/
venv/
# Also match a venv symlinked in from elsewhere: a trailing slash matches only
# directories, so `npa/.venv -> /path/to/venv` would otherwise be committable.
# Scoped to the two paths the repo actually uses, rather than any `venv` at any
# depth.
/.venv
/npa/.venv
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editor and OS files
.DS_Store
.cursor/
.tmp-paste-verify-demo/
.vscode/
.idea/
*.swp
*.swo

# Model checkpoints and generated datasets
*.npy
*.npz
*.safetensors
*.pt
*.pth
*.ckpt
checkpoints/
cosmos3-cache/
npa-cosmos3-cache/

# Temporary and scratch files
tmp/
*.tmp
*.temp

# Wheel cache for npa/scripts/audit_lerobot_release.py
.tmp-lerobot-wheels/

# Node dependencies
node_modules/

# Generated security scan reports
kingfisher-result*.json
semgrep-*.json

# build_docs.sh stages the CLI reference beside docs/cli so the swap is a rename.
# Its cleanup trap removes these; a hard kill cannot, so keep them uncommittable.
docs/.cli-stage-*/
docs/.cli-prev-*/
