ARG BASE_IMAGE=cr.eu-north1.nebius.cloud/your-registry-id/npa-base:cuda13-b300-tag
FROM ${BASE_IMAGE}

ARG BASE_IMAGE=cr.eu-north1.nebius.cloud/your-registry-id/npa-base:cuda13-b300-tag
ARG BUILD_TS=unknown
ARG LEROBOT_VERSION=0.5.1
ARG LEROBOT_COMMIT=1396b9fab7aecddd10006c33c47a487ffdcb54b4
ARG BASE_IMAGE_DIGEST=unknown

LABEL npa.tool="lerobot" \
      npa.version="${LEROBOT_VERSION}" \
      npa.target_gpu="b300-sm_103" \
      npa.base_image="${BASE_IMAGE}" \
      npa.base_image_digest="${BASE_IMAGE_DIGEST}" \
      npa.lerobot.commit="${LEROBOT_COMMIT}" \
      npa.build_ts="${BUILD_TS}" \
      npa.build_info="lerobot_commit=${LEROBOT_COMMIT};base_image=${BASE_IMAGE};base_image_digest=${BASE_IMAGE_DIGEST};build_ts=${BUILD_TS}"

ENV HF_LEROBOT_HOME=/opt/lerobot/hf_cache \
    MUJOCO_GL=egl \
    PYOPENGL_PLATFORM=egl \
    PYTHONUNBUFFERED=1 \
    WANDB_MODE=disabled \
    NPA_INPUT_PATH=/input \
    NPA_OUTPUT_PATH=/output \
    INPUT_PATH=/input \
    OUTPUT_PATH=/output

SHELL ["/bin/bash", "-lc"]

USER root

# LeRobot 0.5.1 requires Python >=3.12, while npa-base intentionally keeps its
# validated CUDA stack in a Python 3.11 venv. Keep that base venv intact for the
# baked GPU validators and add a separate Python 3.12 LeRobot venv. npa-base's
# final CVE hardening force-purges linux-libc-dev, so apt must repair the package
# graph before installing the newer interpreter; purge it again afterwards.
RUN apt-get update \
    && apt-get install -y --no-install-recommends --fix-broken \
    && apt-get install -y --no-install-recommends \
      python3.12 \
      python3.12-dev \
      python3.12-venv \
    && rm -rf /var/lib/apt/lists/*

RUN install -d -m 0755 \
      /opt/lerobot \
      /opt/lerobot/venv \
      /opt/lerobot/checkpoints \
      /opt/lerobot/data \
      /opt/lerobot/dataset_cache \
      /opt/lerobot/checkpoint_cache \
      /opt/lerobot/hf_cache \
      /opt/lerobot/job_status \
      /opt/lerobot/logs \
      /opt/lerobot/benchmarks \
      /output \
    && chown -R 1000:1000 /opt/lerobot /output

WORKDIR /opt/lerobot

USER 1000

RUN python3.12 -m venv /opt/lerobot/venv \
    && /opt/lerobot/venv/bin/python -m pip install --upgrade pip setuptools wheel \
    && /opt/lerobot/venv/bin/python -m pip install \
      torch==2.9.0 \
      torchvision==0.24.0 \
      --index-url https://download.pytorch.org/whl/cu130 \
    && /opt/lerobot/venv/bin/python -m pip install \
      "lerobot[pusht,smolvla,libero] @ git+https://github.com/huggingface/lerobot.git@${LEROBOT_COMMIT}" \
      boto3 \
      fastapi~=0.136.1 \
      num2words \
      tensorboard \
      torchcodec==0.8.1 \
      "uvicorn[standard]" \
      wandb

ENV PATH=/opt/lerobot/venv/bin:/opt/npa/venv/bin:$PATH \
    PYTHONPATH=/opt/npa/src \
    NPA_SKIP_EAGER_IMPORTS=1

COPY --chown=1000:1000 pyproject.toml /opt/npa/pyproject.toml
COPY --chown=1000:1000 src/npa /opt/npa/src/npa

RUN /opt/lerobot/venv/bin/python - <<'PY'
import importlib
from importlib import metadata

for module in ("lerobot", "torch", "torchvision", "torchcodec"):
    importlib.import_module(module)
print("lerobot", metadata.version("lerobot"))
print("torch", metadata.version("torch"))
print("torchcodec", metadata.version("torchcodec"))
PY

RUN /opt/lerobot/venv/bin/python -m pip install --no-deps -e /opt/npa \
    && /opt/lerobot/venv/bin/python -m npa.smoke.test_lerobot_env

USER root

RUN dpkg --purge --force-depends linux-libc-dev

USER 1000

CMD ["lerobot-train", "--help"]
