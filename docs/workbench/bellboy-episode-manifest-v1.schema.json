{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nebius.ai/npa/schemas/bellboy-episode-manifest-v1.schema.json",
  "title": "Bellboy robot episode manifest",
  "description": "Versioned references to gripper RGB, actions, joint state, outcomes, and corrective retries. Customer data stays in S3-compatible object storage.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "dataset_id", "version", "quality_stats", "camera", "action_schema", "episodes", "records"],
  "properties": {
    "schema": {"const": "npa.bellboy.episode_manifest.v1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "quality_stats": {
      "description": "npa.dataset.manifest.v1-compatible aggregate fields consumed by workbench.dataset.validate.",
      "type": "object",
      "required": ["record_count", "mean_completeness", "corrupt_count"],
      "properties": {
        "record_count": {"type": "integer", "minimum": 1},
        "modalities": {"type": "array", "items": {"type": "string"}},
        "events": {"type": "array", "items": {"type": "string"}},
        "locations": {"type": "array", "items": {"type": "string"}},
        "mean_completeness": {"type": "number", "minimum": 0, "maximum": 1},
        "corrupt_count": {"type": "integer", "minimum": 0},
        "per_modality_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "camera": {
      "type": "object",
      "required": ["modality", "mount", "projection"],
      "properties": {
        "modality": {"const": "rgb"},
        "mount": {"const": "gripper"},
        "projection": {"type": "string", "minLength": 1}
      }
    },
    "action_schema": {
      "type": "object",
      "required": ["uri", "version"],
      "properties": {
        "uri": {"type": "string", "pattern": "^s3://[^/]+/.+"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["episode_id", "split", "task", "outcome", "observation", "actions", "joint_state", "timing"],
        "properties": {
          "episode_id": {"type": "string", "minLength": 1},
          "split": {"enum": ["train", "validation", "heldout"]},
          "task": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["success", "failure", "partial", "aborted"]},
          "observation": {
            "type": "object",
            "required": ["gripper_rgb_uri", "timestamps_uri"],
            "properties": {
              "gripper_rgb_uri": {"type": "string", "pattern": "^s3://[^/]+/.+"},
              "timestamps_uri": {"type": "string", "pattern": "^s3://[^/]+/.+"}
            }
          },
          "actions": {
            "type": "object",
            "required": ["uri", "timestamps_uri"],
            "properties": {
              "uri": {"type": "string", "pattern": "^s3://[^/]+/.+"},
              "timestamps_uri": {"type": "string", "pattern": "^s3://[^/]+/.+"}
            }
          },
          "joint_state": {
            "type": "object",
            "required": ["uri", "timestamps_uri"],
            "properties": {
              "uri": {"type": "string", "pattern": "^s3://[^/]+/.+"},
              "timestamps_uri": {"type": "string", "pattern": "^s3://[^/]+/.+"}
            }
          },
          "timing": {
            "type": "object",
            "required": ["clock", "start_ns", "end_ns"],
            "properties": {
              "clock": {"type": "string", "minLength": 1},
              "start_ns": {"type": "integer"},
              "end_ns": {"type": "integer"}
            }
          },
          "recovery": {
            "type": "object",
            "required": ["attempt", "correction"],
            "properties": {
              "attempt": {"type": "integer", "minimum": 1},
              "parent_episode_id": {"type": "string"},
              "correction": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "records": {
      "description": "npa.dataset.manifest.v1-compatible gripper-video records for the existing Dataset-of-Record validator/indexer.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["record_id", "modality", "uri"],
        "properties": {
          "record_id": {"type": "string", "minLength": 1},
          "modality": {"const": "gripper_rgb"},
          "uri": {"type": "string", "pattern": "^s3://[^/]+/.+"}
        }
      }
    }
  }
}
