{
  "state_directory": "~/.local/state/npa-specialists",
  "default_profile": "cosmos",
  "router": "explicit",
  "profiles": [
    {
      "name": "cosmos",
      "description": "Cosmos data generation, augmentation, and pipeline diagnosis",
      "model": "zai-org/GLM-5.3",
      "base_url": "https://api.tokenfactory.nebius.com/v1",
      "key_env": "NEBIUS_TOKEN_FACTORY_KEY",
      "model_options": {"chat_template_kwargs": {"reasoning_effort": "low"}},
      "workspace": "~/repos/workbench-cosmos",
      "read_paths": ["docs", "skills", "workflows", "npa/src/npa/workflows"],
      "write_paths": ["workflows/main/paidf-cosmos3.yaml"],
      "operations": {
        "validate": {
          "description": "Validate the Cosmos3 workflow without submitting a workload",
          "argv": ["{python}", "-m", "npa", "workbench", "workflow", "validate-spec", "workflows/main/paidf-cosmos3.yaml", "--json"]
        },
        "plan": {
          "description": "Render the Cosmos3 workflow plan without executing it",
          "argv": ["{python}", "-m", "npa", "workbench", "workflow", "plan-spec", "workflows/main/paidf-cosmos3.yaml", "--json"]
        }
      }
    },
    {
      "name": "sim2real",
      "description": "Simulation-to-real pipeline contracts, validation, and failure diagnosis",
      "model": "deepseek-ai/DeepSeek-V4-Pro-0813",
      "base_url": "https://api.tokenfactory.nebius.com/v1",
      "key_env": "NEBIUS_TOKEN_FACTORY_KEY",
      "model_options": {"reasoning_effort": "none"},
      "workspace": "~/repos/workbench-sim2real",
      "read_paths": ["docs", "skills", "workflows", "npa/src/npa/workflows/sim2real"],
      "write_paths": ["workflows/main/sim2real.yaml"],
      "operations": {
        "validate": {
          "description": "Validate the Sim2Real workflow without submitting a workload",
          "argv": ["{python}", "-m", "npa", "workbench", "workflow", "validate-spec", "workflows/main/sim2real.yaml", "--json"]
        },
        "plan": {
          "description": "Render the Sim2Real workflow plan without executing it",
          "argv": ["{python}", "-m", "npa", "workbench", "workflow", "plan-spec", "workflows/main/sim2real.yaml", "--assume-decision", "promote_checkpoint", "--json"]
        }
      }
    }
  ]
}
